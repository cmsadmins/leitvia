msgstr ""

#: patterns/content-asymmetric.php
msgctxt "Pattern title"
msgid "Asymmetric feature"
msgstr ""

#: patterns/content-asymmetric.php
msgctxt "Pattern description"
msgid "Two thirds of text with a large heading next to a portrait image that sits lower than the text, with a caption. Use to tell one idea at length with a picture that keeps the page from feeling boxed in."
msgstr ""

#: patterns/content-author-tip.php
msgid "My tip"
msgstr ""

#: patterns/content-author-tip.php
msgid "Book the first night before you set off. Arriving with a place to sleep makes the rest of the trip feel easy."
msgstr ""

#: patterns/content-author-tip.php
msgid "Alex Morgan, author"
msgstr ""

#: patterns/content-author-tip.php
msgctxt "Pattern title"
msgid "Author tip"
msgstr ""

#: patterns/content-author-tip.php
msgctxt "Pattern description"
msgid "A short tip in the voice of the author with a large round portrait in an accent ring, a small heart before the eyebrow and the name in italics, on a soft tinted panel. Save it once as a synced pattern with a real portrait and repeat it every three to five sections of a long guide; tip and name can be overridden in every copy."
msgstr ""

#: patterns/content-break-image.php
msgid "Some things need room. A quiet page gives readers the time to think."
msgstr ""

#: patterns/content-break-image.php
