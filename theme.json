				"typography": {
					"fontFamily": "var:preset|font-family|ui",
					"fontSize": "var:preset|font-size|meta"
				},
				"color": {
					"text": "var:preset|color|ink-muted"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var:preset|font-family|ui",
					"fontSize": "var:preset|font-size|meta"
