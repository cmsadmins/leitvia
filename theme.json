		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "rem", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "xxs", "name": "2XS", "size": "0.25rem" },
				{ "slug": "xs", "name": "XS", "size": "0.5rem" },
				{ "slug": "s", "name": "S", "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)" },
				{ "slug": "m", "name": "M", "size": "clamp(1.25rem, 1rem + 1vw, 1.75rem)" },
				{ "slug": "l", "name": "L", "size": "clamp(2rem, 1.5rem + 2vw, 3rem)" },
				{ "slug": "xl", "name": "XL", "size": "clamp(3rem, 2rem + 3vw, 4.5rem)" },
				{ "slug": "xxl", "name": "2XL", "size": "clamp(4rem, 2.5rem + 5vw, 7rem)" },
				{ "slug": "xxxl", "name": "3XL", "size": "clamp(5rem, 3rem + 7vw, 10rem)" }
			]
		},
		"border": {
			"radiusSizes": [
				{ "slug": "none", "name": "None", "size": "0" },
				{ "slug": "s", "name": "Small", "size": "0.125rem" },
				{ "slug": "m", "name": "Medium", "size": "0.5rem" },
				{ "slug": "l", "name": "Large", "size": "1rem" },
				{ "slug": "pill", "name": "Pill", "size": "999rem" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "subtle", "name": "Subtle", "shadow": "0 1px 2px rgb(0 0 0 / 0.06), 0 2px 8px rgb(0 0 0 / 0.06)" },
				{ "slug": "raised", "name": "Raised", "shadow": "0 2px 6px rgb(0 0 0 / 0.05), 0 12px 24px rgb(0 0 0 / 0.07)" }
			]
		},
		"blocks": {
			"core/heading": { "background": { "backgroundImage": false }, "typography": { "textShadow": false } },
			"core/paragraph": { "background": { "backgroundImage": false }, "typography": { "textShadow": false } },
			"core/list": { "background": { "backgroundImage": false } },
			"core/list-item": { "background": { "backgroundImage": false } },
			"core/quote": { "background": { "backgroundImage": false } },
			"core/pullquote": { "background": { "backgroundImage": false } },
			"core/verse": { "background": { "backgroundImage": false } },
			"core/preformatted": { "background": { "backgroundImage": false } },
			"core/code": { "background": { "backgroundImage": false } },
			"core/details": { "background": { "backgroundImage": false } },
			"core/table": { "background": { "backgroundImage": false } },
			"core/button": { "background": { "backgroundImage": false } },
			"core/post-title": { "background": { "backgroundImage": false } },
			"core/post-excerpt": { "background": { "backgroundImage": false } },
			"core/query-title": { "background": { "backgroundImage": false } },
			"core/site-title": { "background": { "backgroundImage": false } },
			"core/site-tagline": { "background": { "backgroundImage": false } }
		}
	},
	"styles": {
		"variations": {
			"inverse": {
				"color": { "background": "var:preset|color|ink", "text": "var:preset|color|surface" }
			}
		},
		"color": {
			"background": "var:preset|color|surface",
			"text": "var:preset|color|ink"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|body",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|m",
			"padding": {
				"left": "max(var(--wp--preset--spacing--m), (100vw - var(--wp--style--global--wide-size)) / 2)",
				"right": "max(var(--wp--preset--spacing--m), (100vw - var(--wp--style--global--wide-size)) / 2)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "400",
					"lineHeight": "1.1",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|heading-l",
					"lineHeight": "1.08",
					"letterSpacing": "-0.018em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|heading-m",
					"lineHeight": "1.12",
					"letterSpacing": "-0.015em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|heading-s",
					"lineHeight": "1.25",
					"letterSpacing": "-0.005em"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|lead",
					"lineHeight": "1.35",
					"letterSpacing": "0"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|body",
					"lineHeight": "1.35",
					"letterSpacing": "0"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var:preset|font-family|ui",
					"fontSize": "var:preset|font-size|meta",
					"fontWeight": "500",
					"lineHeight": "1.4",
					"textTransform": "uppercase",
					"letterSpacing": "0.1em"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|accent"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|ink"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|focus",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					},
					"shadow": "0 0 0 2px var(--wp--preset--color--surface)"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|ink",
					"text": "var:preset|color|surface"
				},
				"border": {
					"color": "var:preset|color|ink",
					"radius": "var:preset|border-radius|s",
					"style": "solid",
					"width": "1px"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|ui",
					"fontSize": "0.9375rem",
					"fontWeight": "500",
					"letterSpacing": "0.01em",
					"lineHeight": "1.2"
				},
				"spacing": {
					"padding": {
						"top": "0.875rem",
						"bottom": "0.875rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"border": {
						"color": "var:preset|color|accent"
					},
					"color": {
						"background": "var:preset|color|accent",
						"text": "var:preset|color|on-accent"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|focus",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var:preset|font-size|meta"
				},
				"color": {
					"text": "var:preset|color|ink-muted"
				}
			},
			"cite": {
				"typography": {
					"fontSize": "var:preset|font-size|meta",
					"fontStyle": "normal"
				},
				"color": {
					"text": "var:preset|color|ink-muted"
				}
			},
			"textInput": {
				"typography": {
					"fontFamily": "var:preset|font-family|ui"
				},
				"border": {
					"color": "var:preset|color|ink-muted",
					"width": "1px",
					"style": "solid",
					"radius": "var:preset|border-radius|s"
				},
				"color": {
					"background": "var:preset|color|surface",
					"text": "var:preset|color|ink"
				}
			},
			"select": {
				"typography": {
					"fontFamily": "var:preset|font-family|ui"
				},
				"border": {
					"color": "var:preset|color|ink-muted",
					"width": "1px",
					"style": "solid",
					"radius": "var:preset|border-radius|s"
				},
				"color": {
					"background": "var:preset|color|surface",
					"text": "var:preset|color|ink"
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "currentColor",
							"style": "solid",
							"width": "1px"
						},
						"color": {
							"background": "transparent",
							"text": "var:preset|color|ink"
						},
						"spacing": {
							"padding": {
								"top": "0.875rem",
								"bottom": "0.875rem",
								"left": "1.5rem",
								"right": "1.5rem"
							}
						}
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|stroke"
